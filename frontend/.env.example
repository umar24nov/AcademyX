# Frontend env vars
#
# Only NEXT_PUBLIC_* variables can be referenced from client code, and
# anything with that prefix is exposed to browsers. Never put API keys,
# secrets, or passwords here — keep those server-side (backend/.env).
#
# Public base URL of the AcademyX API (Render). Falls back to
# http://localhost:5000/api/v1 when unset (local development).
NEXT_PUBLIC_API_URL=https://academyx-api.onrender.com/api/v1
