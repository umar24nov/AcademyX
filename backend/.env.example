# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
# For local dev: postgresql://postgres:password@localhost:5432/academyx
# For production: Neon serverless postgres URL
DATABASE_URL=postgresql://postgres:password@localhost:5432/academyx

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_TOKEN_ROTATION=true

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Cloudinary (media storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 100ms (live classes)
HMS_APP_ID=
HMS_APP_ACCESS_KEY=
HMS_APP_SECRET=
HMS_TEMPLATE_ID=

# Razorpay (payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email
RESEND_API_KEY=
EMAIL_FROM=AcademyX <no-reply@academyx.app>
