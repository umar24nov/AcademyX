# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
# For local dev: postgresql://postgres:password@localhost:5432/academyx
# For production: Neon serverless postgres URL
DATABASE_URL=postgresql://postgres:password@localhost:5432/academyx

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_TOKEN_ROTATION=true

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate limiting (all values are ms / request counts per window, env-tunable)
# Public tier — unauthenticated endpoints (moderate per-IP ceiling)
RATE_LIMIT_PUBLIC_WINDOW_MS=900000
RATE_LIMIT_PUBLIC_MAX=100
# Auth tier — strict per-IP for login/register/refresh/etc.
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20
# Account tier — per-account (email/userId/token) with exponential backoff
RATE_LIMIT_ACCOUNT_WINDOW_MS=900000
RATE_LIMIT_ACCOUNT_MAX=10
# Authenticated tier — looser per-IP for signed-in API traffic
RATE_LIMIT_AUTHENTICATED_WINDOW_MS=900000
RATE_LIMIT_AUTHENTICATED_MAX=300
# Cap for exponential backoff lockout (not a hard permanent lockout)
RATE_LIMIT_MAX_BACKOFF_MS=86400000

# Cloudinary (media storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 100ms (live classes)
HMS_APP_ID=
HMS_APP_ACCESS_KEY=
HMS_APP_SECRET=
HMS_TEMPLATE_ID=

# Razorpay (payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email
RESEND_API_KEY=
EMAIL_FROM=AcademyX <no-reply@academyx.app>
